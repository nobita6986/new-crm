# ==============================================================================
# CRM-CSKH — Optional Drop-In Configuration for Automated Offsite Backup (G07)
# Target path on VPS (root:root, mode 0600, LF line endings):
#   /etc/crm-cskh/offsite-backup.env
#
# Loaded optionally by `crm-cskh-backup.service` (`EnvironmentFile=-/etc/crm-cskh/offsite-backup.env`).
# While this file is absent or commented out, daily scheduled backups remain
# `PARTIAL_LOCAL_ONLY_OFFSITE_PENDING` / `PARTIAL_MANUAL_OFFSITE_VERIFIED_AUTOMATION_BLOCKED`
# (`BLK-INFRA-05` open; `periodic_offsite_upload_proven = false`).
#
# MANDATORY SECURITY & ARCHITECTURE RULES:
# 1. DO NOT select or activate any paid third-party cloud service without Owner approval.
# 2. NEVER point `CSKH_OFFSITE_TARGET_DIR` or upload commands to a folder on the same
#    VPS (`103.77.208.186`). `manage_backup_lifecycle.py` enforces a filesystem device
#    (`st_dev`) check and fails closed if `CSKH_OFFSITE_TARGET_DIR` shares the local disk.
# 3. NEVER upload or reference `backup-key` in `CSKH_OFFSITE_UPLOAD_CMD`. Only
#    `backup.tar.gz.enc` and `backup-report.json` belong in the offsite archive store;
#    each bundle's `backup-key` MUST be escrowed in a physically/logically separate
#    Owner secret vault.
# ==============================================================================

# Descriptive non-secret label recorded in `offsite-verification.json`:
# CSKH_OFFSITE_LOCATION_LABEL=owner-approved-offsite-vault

# ------------------------------------------------------------------------------
# OPTION A: Independent SSH/SFTP Host or NAS (Owned/Approved by Owner)
# Uses a restricted SSH key (`0600`) dedicated to append/write + sha256sum readback.
# Variables injected automatically into subshell by `manage_backup_lifecycle.py`:
#   $CSKH_BUNDLE_NAME, $CSKH_ARCHIVE_PATH, $CSKH_REPORT_PATH,
#   $CSKH_EXPECTED_SHA256, $CSKH_EXPECTED_BYTES
# ------------------------------------------------------------------------------
# CSKH_OFFSITE_UPLOAD_CMD=ssh -i /etc/crm-cskh/secrets/offsite_ssh_ed25519 -o BatchMode=yes <OFFSITE_USER>@<OFFSITE_HOST> "install -d -m 0700 <OFFSITE_BASE_DIR>/$CSKH_BUNDLE_NAME" && scp -i /etc/crm-cskh/secrets/offsite_ssh_ed25519 -o BatchMode=yes "$CSKH_ARCHIVE_PATH" "$CSKH_REPORT_PATH" <OFFSITE_USER>@<OFFSITE_HOST>:<OFFSITE_BASE_DIR>/$CSKH_BUNDLE_NAME/
# CSKH_OFFSITE_VERIFY_CMD=ssh -i /etc/crm-cskh/secrets/offsite_ssh_ed25519 -o BatchMode=yes <OFFSITE_USER>@<OFFSITE_HOST> "sha256sum <OFFSITE_BASE_DIR>/$CSKH_BUNDLE_NAME/backup.tar.gz.enc | awk '{print \$1}' | tr '\n' ' '; wc -c < <OFFSITE_BASE_DIR>/$CSKH_BUNDLE_NAME/backup.tar.gz.enc"

# ------------------------------------------------------------------------------
# OPTION B: Owner-Approved Object Storage / Rclone Remote (S3-Compatible / WebDAV / SFTP)
# Requires `rclone` configured at `/etc/crm-cskh/secrets/rclone.conf` (`0600`) with
# write/readback credentials (separate from delete/admin credentials).
# ------------------------------------------------------------------------------
# CSKH_OFFSITE_UPLOAD_CMD=rclone --config /etc/crm-cskh/secrets/rclone.conf copyto "$CSKH_ARCHIVE_PATH" "<RCLONE_REMOTE>:<BUCKET_OR_PATH>/$CSKH_BUNDLE_NAME/backup.tar.gz.enc" && rclone --config /etc/crm-cskh/secrets/rclone.conf copyto "$CSKH_REPORT_PATH" "<RCLONE_REMOTE>:<BUCKET_OR_PATH>/$CSKH_BUNDLE_NAME/backup-report.json"
# CSKH_OFFSITE_VERIFY_CMD=tmp_v="$(mktemp)" && trap 'rm -f "$tmp_v"' EXIT && rclone --config /etc/crm-cskh/secrets/rclone.conf copyto "<RCLONE_REMOTE>:<BUCKET_OR_PATH>/$CSKH_BUNDLE_NAME/backup.tar.gz.enc" "$tmp_v" && printf '%s %s\n' "$(sha256sum "$tmp_v" | awk '{print $1}')" "$(wc -c < "$tmp_v" | tr -d ' ')"

# ------------------------------------------------------------------------------
# OPTION C: Dedicated Remote Network Mount (NFS/SSHFS/CIFS on a distinct `st_dev` != local disk)
# Forbidden for any local directory on 103.77.208.186!
# ------------------------------------------------------------------------------
# CSKH_OFFSITE_TARGET_DIR=/mnt/owner-external-offsite-vault/crm-cskh
