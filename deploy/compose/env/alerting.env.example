# ==============================================================================
# CRM-CSKH — Optional Drop-In Configuration for External Alert Delivery (G19)
# Target path on VPS (root:root, mode 0600, LF line endings):
#   /etc/crm-cskh/alerting.env
#
# Loaded optionally by:
#   - `crm-cskh-healthcheck.service`
#   - `crm-cskh-backup.service`
#   - `crm-cskh-backup-failure@.service`
#
# GOVERNANCE RULE (`BLK-GOV-06` & `BLK-INFRA-07`):
# DO NOT populate fake recipient names, personal emails, or unapproved webhooks.
# Keep commented out until Owner formally designates the on-call Operator contact
# (`BLK-GOV-06`) and the approved HTTPS webhook endpoint (`BLK-INFRA-07`).
# All outbound alert payloads pass through `redact_payload_text()` (0 raw phones,
# 0 session cookies, 0 CSRF tokens, 0 webhook path secrets) with a 900s cooldown.
# ==============================================================================

# Named Operator / on-call identifier approved by Owner (`BLK-GOV-06`):
# CSKH_OPERATOR_CONTACT=<PENDING_OWNER_ASSIGNMENT_BLK_GOV_06>

# Approved HTTPS webhook endpoint for ChatOps / Pager / Alert Relay (`BLK-INFRA-07`):
# CSKH_ALERT_WEBHOOK_URL=https://<PENDING_OWNER_WEBHOOK_HOST_BLK_INFRA_07>/<PATH>
