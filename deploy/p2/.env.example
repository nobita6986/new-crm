# deploy/p2/.env.example
#
# Sao chép thành .env rồi chỉnh nếu cần:  cp .env.example .env
# .env KHÔNG được commit (deploy/p2/.gitignore khai báo *.env).
#
# CẢNH BÁO: mọi giá trị mật khẩu dưới đây là MẶC ĐỊNH DEV, không phải bí mật.
#           Không dùng cho staging/production.

COMPOSE_PROJECT_NAME=crm-cskh-p2-ui

# ----- Site / tài khoản kiểm thử P2 (dữ liệu giả, tách biệt hoàn toàn với p1.localhost:8120) -----
SITE_NAME=p2.localhost
ADMIN_PASSWORD=p2-only-change-me
DB_ROOT_PASSWORD=p2-only-change-me
TZ=Asia/Ho_Chi_Minh

# ----- Cổng riêng cho stack P2 UI (không đụng Owner p1.localhost 8120/9120/8201,
#       stack DEV 8010/9010/8091, hay stack p1-dev 8110/9110/8190) -----
# VITE_PORT (host) PHẢI BẰNG VITE_DEV_PORT (container) — xem deploy/dev/README.md.
WEB_PORT=8220
SOCKETIO_PORT=9220
VITE_PORT=8292

# ----- Image hạ tầng: ghim tag@digest (KHÔNG dùng tag trôi) -----
# Nguồn: docs/architecture/version-lock.md §5
MARIADB_IMAGE=mariadb:11.8@sha256:f16d7a344413e519dff518f27bdb221388f84b0d274c97c4fb5f2cb0dc1b34fa
REDIS_IMAGE=redis:8.6-alpine@sha256:ac2da09bc822f325a9f68f533120b86fa39c1b8db46b3aa7c1bbea7fdfd4fcba
BENCH_IMAGE=frappe/bench:v5.31.0@sha256:3b75943bf00a1db92723d99ec34fbfa92f4b67b9b643ae1e96750899b7fbd980

# ----- Revision upstream được ghim -----
FRAPPE_TAG=v15.123.1
FRAPPE_SHA=d2efa79657ba5c1abf96098b3bfacc199517d57e
CRM_TAG=v1.87.0
CRM_SHA=0d3910b456ef4fb913e77b29db011b3debc4f778
FRAPPE_DOCKER_SHA=2b26e9ab8d751e5ea33bb7b930aea3550bb81ded

# ----- Bắt buộc cài app chứa permission/API guards của P0/P1/P2 -----
INSTALL_CSKH=1
