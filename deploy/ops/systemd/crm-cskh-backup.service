[Unit]
Description=CRM-CSKH Daily Encrypted Backup + Checksum + GFS Retention (Local Staged; Offsite Upload Manual Until BLK-INFRA-05)
After=docker.service
Requires=docker.service
OnFailure=crm-cskh-backup-failure@%n.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# Render and install via: install_systemd_timers.py --repo-root /opt/crm-cskh-ops --install
ExecStart=/usr/bin/python3 /opt/crm-cskh-ops/deploy/ops/manage_backup_lifecycle.py run-scheduled \
  --compose-wrapper /opt/crm-cskh-staging/staging-compose \
  --site crm-staging.localhost \
  --backup-root /var/backups/crm-cskh \
  --environment-label staging \
  --keep-daily 14 \
  --keep-weekly 8 \
  --keep-monthly 3
