[Unit]
Description=CRM-CSKH Backup Failure Alert Recorder (External Delivery Gated Until BLK-GOV-06 & BLK-INFRA-07)

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# Render and install via: install_systemd_timers.py --repo-root /opt/crm-cskh-ops --install
ExecStart=/usr/bin/python3 /opt/crm-cskh-ops/deploy/ops/manage_backup_lifecycle.py emit-failure-alert \
  --backup-root /var/backups/crm-cskh \
  --environment-label staging \
  --unit-name %i \
  --reason "systemd unit %i exited non-zero"
