# deploy/dev/.env.example
#
# Sao chép thành .env rồi chỉnh nếu cần:  cp .env.example .env
# .env KHÔNG được commit (đã có .gitignore trong thư mục này).
#
# CẢNH BÁO: mọi giá trị mật khẩu dưới đây là MẶT ĐỊNH DEV, không phải bí mật.
#           Không dùng cho staging/production.

COMPOSE_PROJECT_NAME=crm-cskh-dev

# ----- Site / tài khoản DEV (dữ liệu giả) -----
SITE_NAME=dev.localhost
ADMIN_PASSWORD=dev-only-change-me
DB_ROOT_PASSWORD=dev-only-change-me
TZ=Asia/Ho_Chi_Minh

# ----- Cổng (chỉ bind 127.0.0.1) -----
WEB_PORT=8000
SOCKETIO_PORT=9000
VITE_PORT=8080

# ----- Image hạ tầng: ghim tag@digest (KHÔNG dùng tag trôi) -----
# Nguồn: docs/architecture/version-lock.md §5
# Lưu ý: digest được cập nhật 2026-10-19 sau khi upstream rebuild image (cùng tag).
MARIADB_IMAGE=mariadb:11.8@sha256:f16d7a344413e519dff518f27bdb221388f84b0d274c97c4fb5f2cb0dc1b34fa
REDIS_IMAGE=redis:8.6-alpine@sha256:ac2da09bc822f325a9f68f533120b86fa39c1b8db46b3aa7c1bbea7fdfd4fcba
BENCH_IMAGE=frappe/bench:v5.31.0@sha256:3b75943bf00a1db92723d99ec34fbfa92f4b67b9b643ae1e96750899b7fbd980

# ----- Revision upstream được ghim (KHÔNG dùng latest/main/develop) -----
# Nguồn: docs/architecture/version-lock.md §2
FRAPPE_TAG=v15.123.1
FRAPPE_SHA=d2efa79657ba5c1abf96098b3bfacc199517d57e
CRM_TAG=v1.87.0
CRM_SHA=0d3910b456ef4fb913e77b29db011b3debc4f778
FRAPPE_DOCKER_SHA=2b26e9ab8d751e5ea33bb7b930aea3550bb81ded

# ----- Đặt 1 khi app crm_cskh đã tồn tại trong repo (WP-02) -----
INSTALL_CSKH=0
