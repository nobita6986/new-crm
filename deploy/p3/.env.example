# deploy/p3/.env.example
#
# Sao chép thành .env rồi chỉnh nếu cần:  cp .env.example .env
# .env KHÔNG được commit (deploy/p3/.gitignore khai báo *.env).

COMPOSE_PROJECT_NAME=crm-cskh-p3-ui

SITE_NAME=p3ui.localhost
ADMIN_PASSWORD=p3-only-change-me
DB_ROOT_PASSWORD=p3-only-change-me
TZ=Asia/Ho_Chi_Minh

# Cổng riêng cho stack P3 UI (không đụng Owner 8120, P2 UI 8220, T1B 18320)
WEB_PORT=8320
SOCKETIO_PORT=9320
VITE_PORT=8392

