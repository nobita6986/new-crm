# Root .gitignore — bảo vệ khỏi commit nhầm file tạm/scratch của agent.
# Chỉ áp dụng cho file KHÔNG thuộc gói bàn giao (DEV/i18n/docs/evidence).

# File làm việc tạm của T1A/T1B/T1C
_tmp_*
_t1b_ext1_*
_t1b-*
_t1a_*
_t1b_*
_t1c_*
_a_*.json
_art*
_r[0-9]*.json
_run*
_allruns.json
_scan*.py
_sync*.py
_parse*.py
_fix*.py
_check*.py
_count*.py
_find*.py
_hist*.py
_label*.py
_show*.py
_verify*.py
_audit*.py
_rebuild.py
_chk.md
_d.txt
_remote.md
p4-ops-reh-*/
t1b-ext1-*.json
t1b-http-transport-*.json
t1c-candidate-confirmation-receipt.json

# Thư mục tạm
_recovery/
_tmp_crop/
.commandcode/

# Python
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/

# Node
node_modules/

# Cursor local config (không commit)
.cursor/
